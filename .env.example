# trellis-harness: every environment variable it reads. Nothing else is read.
# Unset means "not in this deployment": no gateway, no memory service, runs kept in process.

# Bifrost's OpenAI-compatible base URL (MCP tools, the ReAct target's models).
BIFROST_URL=http://localhost:8091/v1
# The agent's Bifrost virtual key: its models, its MCP tools, its budget; also registered as its memory model key.
BIFROST_VIRTUAL_KEY=
# The Trellis key for the memory service and agent-runs (tenant and role are the key's own).
TRELLIS_API_KEY=
# Memory service base URL; memory is on exactly when this is set.
MEMORY_URL=http://localhost:8080
# agent-runs base URL (durable runs, the worker queue, the inbox, schedules); unset keeps runs in process.
RUNS_URL=http://localhost:8090
# OTLP/HTTP endpoint traces go to: Langfuse's (…/api/public/otel) or a collector (deploy/otel-collector.yaml).
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP headers, k=v,k2=v2 (Langfuse: Authorization=Basic <base64 pk:sk>; via a collector add x-langfuse-host=<url>).
OTEL_EXPORTER_OTLP_HEADERS=
# A directory memory writes this process could not deliver are kept in (JSONL), replayed at the next start; unset: logged, counted, lost.
TRELLIS_SPOOL_DIR=
# Runs one worker process executes at once (python -m trellis.harness.worker also takes --concurrency); unset: the CPU count, 1 to 8.
TRELLIS_WORKER_CONCURRENCY=
# The version of the agents' code (a release or deploy id), recorded with every run they start; h.wrap(..., version=) wins over it.
TRELLIS_AGENT_VERSION=
# The share of successful runs (0 to 1, chosen by the run id) whose answer the memory service checks against its context (/v1/verify); unset: 0.1.
TRELLIS_GROUNDING_SAMPLE=
# The Bifrost model llm_judge asks (a stronger model than the agent's avoids self-grading); unset: the judged agent's own model.
TRELLIS_JUDGE_MODEL=
# The Bifrost virtual key the judge's calls go through (a separate budget for evaluation); unset: BIFROST_VIRTUAL_KEY.
TRELLIS_JUDGE_VIRTUAL_KEY=
# The share of successful runs (0 to 1, chosen by the run id) the online judges score (Harness(judges=[...])); unset: 0.1 with judges.
TRELLIS_JUDGE_SAMPLE=
