# trellis-harness: every environment variable it reads. Nothing else is read.
# Unset means "not in this deployment": no endpoint (each provider's own SDK), no memory service,
# runs kept in process. Each setting lives in one layer: endpoints and keys here; agent behaviour
# in code; routing, fallbacks, retries, budgets and caching in the gateway (Bifrost). `python -m trellis.harness.doctor` (or
# `trellis doctor`) prints the effective settings and where each came from.

# The OpenAI-compatible /v1 root every model name goes to (OpenAI, OpenRouter, a LiteLLM proxy, Ollama, vLLM, llama.cpp, Bifrost...); unset: each provider's own SDK and key. The memory service is told it per agent, so its own model work goes there too.
LLM_BASE_URL=http://localhost:8091/v1
# The endpoint's bearer key (Bifrost's: the agent's virtual key — its models, its MCP tools, its budget); unset: none sent.
LLM_API_KEY=
# The route: openai-compatible (unset: model names as given) or bifrost (provider/model names, and its MCP tools, Code Mode, stored prompts, skills, the Claude Agent SDK's Anthropic route); or one a package registers (entry points, trellis.gateways).
LLM_GATEWAY=bifrost
# How the endpoint's requests are authenticated: bearer (unset; LLM_API_KEY), google (a refreshed Google token: trellis-harness[vertex]) or aws (SigV4: trellis-harness[bedrock]); a login sends no key.
LLM_AUTH=
# The Bifrost virtual key the judge's calls go through: evaluation's own budget, rate limits and models; unset: LLM_API_KEY.
TRELLIS_JUDGE_VIRTUAL_KEY=
# The Trellis key for the memory service and agent-runs (tenant and role are the key's own).
TRELLIS_API_KEY=
# Memory service base URL; memory is on exactly when this is set.
MEMORY_URL=http://localhost:8080
# agent-runs base URL (durable runs, the worker queue, the inbox, schedules); unset keeps runs in process.
RUNS_URL=http://localhost:8090
# A directory memory writes this process could not deliver are kept in (JSONL), replayed at the next start; unset: the XDG state folder outside a container, else none (lost at a restart, said once).
TRELLIS_SPOOL_DIR=
# Langfuse, by its own names (LANGFUSE_BASE_URL unset: Langfuse Cloud): its scores and datasets; and the traces, when no OTEL_EXPORTER_OTLP_* variable is set.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# The tools' own standard variables, read by their SDKs (not by the harness's settings):
# OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, OTEL_EXPORTER_OTLP_HEADERS,
# OTEL_SERVICE_NAME, OTEL_RESOURCE_ATTRIBUTES (service.version=<the agents' version>, baked in at
# build time), DOCKER_HOST (where sandbox() makes its sandboxes); and, without LLM_BASE_URL, each
# provider SDK's own key and endpoint (OPENAI_API_KEY and OPENAI_BASE_URL: LiteLLM, vLLM, Ollama,
# OpenAI; ANTHROPIC_API_KEY, GOOGLE_API_KEY, Google's and AWS's credentials...).

