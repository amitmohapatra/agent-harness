# trellis-harness: every environment variable it reads. Nothing else is read.
# Unset means "not in this deployment": no gateway, no memory service, runs kept in process.
# Each setting lives in one layer: endpoints and keys here; agent behaviour in code; routing,
# fallbacks, retries, budgets and caching in Bifrost. `python -m trellis.harness.doctor` (or
# `trellis doctor`) prints the effective settings and where each came from.

# Bifrost's OpenAI-compatible base URL (MCP tools, the ReAct target's models).
BIFROST_URL=http://localhost:8091/v1
# The agent's Bifrost virtual key: its models, its MCP tools, its budget; also registered as its memory model key.
BIFROST_VIRTUAL_KEY=
# The Bifrost virtual key the judge's calls go through: evaluation's own budget, rate limits and models; unset: BIFROST_VIRTUAL_KEY.
TRELLIS_JUDGE_VIRTUAL_KEY=
# The Trellis key for the memory service and agent-runs (tenant and role are the key's own).
TRELLIS_API_KEY=
# Memory service base URL; memory is on exactly when this is set.
MEMORY_URL=http://localhost:8080
# agent-runs base URL (durable runs, the worker queue, the inbox, schedules); unset keeps runs in process.
RUNS_URL=http://localhost:8090
# A directory memory writes this process could not deliver are kept in (JSONL), replayed at the next start; unset: the XDG state folder outside a container, else none (lost at a restart, said once).
TRELLIS_SPOOL_DIR=
# Langfuse, by its own names (LANGFUSE_BASE_URL unset: Langfuse Cloud): its scores and datasets; and the traces, when no OTEL_EXPORTER_OTLP_* variable is set.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# The tools' own standard variables, read by their SDKs (not by the harness's settings):
# OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, OTEL_EXPORTER_OTLP_HEADERS,
# OTEL_SERVICE_NAME, OTEL_RESOURCE_ATTRIBUTES (service.version=<the agents' version>, baked in at
# build time), DOCKER_HOST (where sandbox() makes its sandboxes); and, without BIFROST_URL, each
# provider SDK's own key and endpoint (OPENAI_API_KEY and OPENAI_BASE_URL: LiteLLM, vLLM, Ollama,
# OpenAI; ANTHROPIC_API_KEY...).

