# trellis-harness: every environment variable it reads. Nothing else is read.
# Unset means "not in this deployment": no gateway, no memory service, runs kept in process.

# Tenant a single-tenant deployment runs as when a call names none (default: "default").
TRELLIS_TENANT=acme
# Bifrost's OpenAI-compatible base URL (MCP tools, the ReAct target, the judge's model).
BIFROST_URL=http://localhost:8091/v1
# Bifrost virtual key sent on every gateway call (governance, budgets, MCP allow-list).
BIFROST_VIRTUAL_KEY=
# Memory service base URL (context push, agent tools, transcripts, feedback).
MEMORY_URL=http://localhost:8080
# Memory service API key.
MEMORY_API_KEY=
# LLM key the memory service uses for this deployment's agents (registered per agent at startup).
TRELLIS_MEMORY_MODEL_KEY=
# agent-runs base URL (runs, the worker queue, the inbox, schedules); unset keeps runs in process.
RUNS_URL=http://localhost:8090
# agent-runs API key.
RUNS_API_KEY=
# Fraction of finished runs the online judge scores, 0..1 (default 0.1).
TRELLIS_EVAL_SAMPLE=0.1
# OTLP endpoint traces are exported to (needs the [otel] extra).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Langfuse keys and host: traces go to Langfuse's OTLP endpoint (needs the [otel] extra).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
