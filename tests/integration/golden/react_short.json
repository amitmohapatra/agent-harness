        "function": {
          "description": "Run a task later or on a timetable when the user asks for that ('every Monday...', 'tomorrow at 9...', 'tell me when...'), not when a question only mentions a time or a habit; the reply comes back to this chat. A condition: first check it once now with your tools and tell the user the value; one that holds already: say so, and schedule only if they want to hear again. If no tool of yours can check it, do not schedule: say so and offer two or three things your tools can watch, by name. A vague ask ('keep an eye on sales'): call with choices, 2-3 concrete schedules your tools can run, the best first; the user picks one. No time said: 9:00. A schedule like one the user has is asked about here. One schedule a request. It is now <day, hour> (UTC; the user's zone is not known).",
          "name": "schedule_task",
          "parameters": {
            "properties": {
              "choices": {
                "description": "Only for a vague ask: 2-3 concrete schedules, the best first; the user picks one, which is made.",
                "items": {
                  "properties": {
                    "condition": {
                      "description": "Report only when this holds.",
                      "type": "string"
                    },
                    "task": {
                      "description": "What to do, as the user said it.",
                      "type": "string"
                    },
                    "when": {
                      "description": "A new 5-field cron.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "task",
                    "when"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "condition": {
                "description": "Report only when this holds.",
                "type": "string"
              },
              "in_minutes": {
                "description": "Instead of when: run once this many minutes from now ('in 2 hours': 120).",
                "type": "number"
              },
              "once": {
                "description": "Run once, then end.",
                "type": "boolean"
              },
              "task": {
                "description": "What to do, as the user said it.",
                "type": "string"
              },
              "timezone": {
                "description": "An IANA zone, only when the user names one; default theirs.",
                "type": "string"
              },
              "tools": {
