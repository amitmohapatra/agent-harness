                "type": "array"
              },
              "when": {
                "description": "5-field cron in the user's zone: '0 9 * * *' daily 9:00, '0 9,17 * * *' 9:00 and 17:00, '0 9 * * 1-5' weekdays, '0 8 * * 1' Mondays, '0 9 1 * *' the 1st; one day ('tomorrow at 9', 'next Monday at 10') counted from today: '0 9 4 11 *' with once.",
